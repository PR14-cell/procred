# Database
POSTGRES_DB=credentialing
POSTGRES_USER=credentialing_admin
DB_ADMIN_PASSWORD=admin_secret_pass
DB_APP_PASSWORD=app_secret_pass

# Database URLs
# For migrations and admin tasks:
DATABASE_ADMIN_URL=postgresql://credentialing_admin:admin_secret_pass@localhost:5432/credentialing
# For application runtime:
DATABASE_URL=postgresql://credentialing_app:app_secret_pass@localhost:5432/credentialing

# Redis Authentication (C2)
REDIS_PASSWORD=redis_secure_pass_123
REDIS_URL=redis://:redis_secure_pass_123@localhost:6379

# MinIO / S3 Storage
MINIO_USER=minioadmin
MINIO_PASSWORD=miniopassword123
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=miniopassword123
S3_BUCKET_CREDENTIALS=credentials
S3_BUCKET_ENROLLMENTS=enrollments
S3_BUCKET_GENERAL=general

# Security & Encryption (AES-256-GCM 32-byte hex key)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
NEXTAUTH_SECRET=fictional_demo_secret_key_change_in_production_min32chars
NEXTAUTH_URL=http://localhost:3000
APP_DOMAIN=localhost

# Email (SMTP)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=fictional_smtp_user
SMTP_PASS=fictional_smtp_pass
