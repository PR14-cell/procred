# Database
APP_VERSION=1.0.2
HOST_APP_BIND_IP=127.0.0.1
HOST_APP_PORT=3000
POSTGRES_DB=credentialing
POSTGRES_USER=credentialing_admin
DB_ADMIN_PASSWORD=CHANGE_ME_64_HEX_ADMIN_PASSWORD
DB_APP_PASSWORD=CHANGE_ME_64_HEX_APP_PASSWORD

# Database URLs
# For migrations and admin tasks:
DATABASE_ADMIN_URL=postgresql://credentialing_admin:CHANGE_ME_64_HEX_ADMIN_PASSWORD@localhost:5432/credentialing
# For application runtime:
DATABASE_URL=postgresql://credentialing_app:CHANGE_ME_64_HEX_APP_PASSWORD@localhost:5432/credentialing

# Redis Authentication (C2)
REDIS_PASSWORD=CHANGE_ME_64_HEX_REDIS_PASSWORD
REDIS_URL=redis://:CHANGE_ME_64_HEX_REDIS_PASSWORD@localhost:6379

# MinIO / S3 Storage
MINIO_USER=credentialing_minio_admin
MINIO_PASSWORD=CHANGE_ME_64_HEX_MINIO_PASSWORD
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=miniopassword123
S3_BUCKET_CREDENTIALS=credentials
S3_BUCKET_ENROLLMENTS=enrollments
S3_BUCKET_GENERAL=general

# Security & Encryption (AES-256-GCM 32-byte hex key)
ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHAR_KEY_FROM_openssl_rand_hex_32
NEXTAUTH_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
NEXTAUTH_URL=http://localhost:3000
APP_DOMAIN=localhost

# Email (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=CHANGE_ME_SMTP_USER
SMTP_PASS=CHANGE_ME_SMTP_PASSWORD
SMTP_FROM=noreply@credentialing.example.com

# Initial Setup Token (required for first-time /setup bootstrap of the super_admin account)
INITIAL_SETUP_TOKEN=REPLACE_WITH_RANDOM_BOOTSTRAP_TOKEN

# Temporary password provisioned after a fresh-install reset (not a default login password)
INITIAL_ADMIN_PASSWORD=

# Cookie Security (true for HTTPS reverse proxy; set false only if accessing over direct LAN HTTP)
COOKIE_SECURE=true

# Reverse Proxy Trust (set to "true" when running behind Caddy, Nginx Proxy Manager, Cloudflare, etc.
# Enables getClientIp to accurately read the client IP from the first entry of X-Forwarded-For)
TRUST_PROXY=true

